{
  "name": "@hilvana/office",
  "version": "0.1.0",
  "description": "Hilvana office conversions that run locally: Word (.docx) to PDF with real, selectable text.",
  "keywords": [
    "docx",
    "word",
    "pdf",
    "convert",
    "word-to-pdf",
    "local"
  ],
  "license": "MIT",
  "author": "Jorge Grajales (https://jorgegrajales.dev)",
  "homepage": "https://github.com/gethilvana/hilvana#readme",
  "bugs": {
    "url": "https://github.com/gethilvana/hilvana/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gethilvana/hilvana",
    "directory": "packages/office"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1"
  }
}
