{
  "name": "hilvana",
  "version": "0.9.0",
  "description": "Hilvana CLI: private, local PDF workflows from the terminal. Merge, split, sign, number and clean PDFs, or run whole recipes.",
  "keywords": [
    "pdf",
    "cli",
    "merge",
    "sign",
    "privacy"
  ],
  "license": "MIT",
  "author": "Jorge Grajales (https://jorgegrajales.dev)",
  "homepage": "https://github.com/gethilvana/hilvana#readme",
  "bugs": {
    "url": "https://github.com/gethilvana/hilvana/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gethilvana/hilvana.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "hilvana": "dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@hilvana/core": "0.9.0",
    "@hilvana/office": "0.9.0",
    "@hilvana/recipes": "0.9.0"
  }
}
