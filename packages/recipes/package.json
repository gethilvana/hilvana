{
  "name": "@hilvana/recipes",
  "version": "0.7.0",
  "description": "Hilvana recipes: a versioned JSON format for chained PDF and Word operations, with validation, execution and goal verification.",
  "keywords": [
    "pdf",
    "workflow",
    "recipes",
    "agents",
    "json-schema"
  ],
  "license": "MIT",
  "author": "Jorge Grajales (https://jorgegrajales.dev)",
  "homepage": "https://github.com/gethilvana/hilvana#readme",
  "bugs": {
    "url": "https://github.com/gethilvana/hilvana/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gethilvana/hilvana.git",
    "directory": "packages/recipes"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@hilvana/core": "0.7.0",
    "zod": "^4.1.0",
    "@hilvana/office": "0.7.0"
  }
}
